{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cargo build (debug)",
            "type": "shell",
            "command": "cargo",
            "args": ["build", "-p", "bungalow-client"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$rustc"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "cargo build (debug, wef, audio)",
            "type": "shell",
            "command": "cargo",
            "args": ["build", "-p", "bungalow-client", "--features", "wef,audio"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$rustc"],
            "group": "build"
        },
        {
            "label": "cargo build (release)",
            "type": "shell",
            "command": "cargo",
            "args": ["build", "--release", "-p", "bungalow-client"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$rustc"],
            "group": "build"
        }
    ]
}
